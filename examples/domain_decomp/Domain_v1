solveB = bvplin_solver(1 / 20, zero, zero, x -> -rhs_func(x), [xB[1], xB[end]], length(xB) - 1)

# Wrap solvers
wrap_solver(solver) = u -> begin
    l = u[1]
    r = u[end]
    x, u = solver(l, r)
    return u
end

f1 = wrap_solver(solveA)
f2 = wrap_solver(solveB)

# Create restriction matrices
function restriction_matrices(A, B, AB)
    p1 = zeros(AB, A)
    p1[1:AB, end-AB+1:end] .= I(AB)

    p2 = zeros(AB, B)
    p2[1:AB, 1:AB] .= I(AB)
    return p1, p2
end

A = length(xA)
B = length(xB)
p1, p2 = restriction_matrices(A, B, AB)

# Alternating projection
function alternating_projection(u₀, niter=1)
    function update(u1, u2)
        u1[end] = u2[AB]
        u1 = f1(u1)
        u2[1] = u1[end-AB]
        u2 = f2(u2)
        return u1, u2
    end
    u1 = u₀[1:A]
    u2 = u₀[end-B+1:end]
    for i in 1:niter
        u1, u2 = update(u1, u2)
    end
    return vcat(u1[1:end-AB], u2)
end

